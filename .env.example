# Copy to .env and fill in from Supabase: Project Settings > API.
# Only the publishable (anon) key belongs in the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: the public web address that confirmation and reset emails link back to.
# It must also be listed under Authentication > URL Configuration in Supabase.
# VITE_AUTH_REDIRECT_URL=https://your-app.example.com
